{
    "WeatherApi": {
        "BaseUrl_ssh": "https://host.docker.internal:7221/api/weather/",
        "BaseUrl_dev": "http://host.docker.internal:5185/api/weather/",
        "BaseUrl": "https://weather.janohorak.com/api/weather/",
        "Token": "weather-mock-secret-token"
    },
    "Redis": {
        "ConnectionString": "host.docker.internal:6379"
    },
    "TemperatureRefresh": {
        "UseDevelopmentInterval": true,
        "DevelopmentIntervalSeconds": 60,
        "RefreshHoursUtc": [ 9, 16 ]
    },
    "ApiAuth": {
        "Token": "temperature-api-secret-token"
    },
    "Logging": {
        "LogLevel": {
            "Default": "Information",
            "Microsoft.AspNetCore": "Warning"
        }
    },
    "AllowedHosts": "*"
}
